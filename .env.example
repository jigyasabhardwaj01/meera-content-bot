# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the only person the bot will respond to (Meera).
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_USER_ID=
# Optional: set this to any random string and pass the same value as
# `secret_token` when calling setWebhook (see scripts/set-webhook.ts).
# The bot then rejects any webhook request missing/mismatching this header.
TELEGRAM_WEBHOOK_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
# Fast/cheap model used for transcription + triage scoring.
GEMINI_FLASH_MODEL=gemini-3.5-flash
# More capable model used for the actual LinkedIn draft.
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- Triage ---
# Notes scoring below this (0-10) are rejected before a draft is ever written.
TRIAGE_THRESHOLD=6
